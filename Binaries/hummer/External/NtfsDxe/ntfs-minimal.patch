-static grub_uint32_t
-reflect(grub_uint32_t ref, int len)
-{
-	grub_uint32_t result = 0;
-	int i;
-
-	for (i = 1; i <= len; i++) {
-		if (ref & 1)
-			result |= 1 << (len - i);
-		ref >>= 1;
-	}
-
-	return result;
-}
