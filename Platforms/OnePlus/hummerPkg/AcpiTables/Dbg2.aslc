#include "AcpiTables.h"
#include <IndustryStandard/DebugPort2Table.h>

#pragma pack (1)
typedef struct {
  UINT8 Type;
  UINT8 Phase;
  UINT16 Reserved;
  UINT32 Offset;
  UINT32 AndMask;
  UINT32 OrMask;
} HUMMER_USB_FIX;

typedef struct {
  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT Info;
  EFI_ACPI_6_4_GENERIC_ADDRESS_STRUCTURE Registers[2];
  UINT32 RegisterSizes[2];
  CHAR8 Name[2];
  UINT32 OemVersion;
  UINT32 OemSignature;
  UINT32 FixCount;
  HUMMER_USB_FIX Fixes[2];
} HUMMER_USB_DEBUG;

typedef struct {
  EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE Header;
  HUMMER_USB_DEBUG Usb;
} HUMMER_DBG2;
#pragma pack ()

HUMMER_DBG2 Dbg2 = {
  .Header = {
    .Header = HUMMER_ACPI_HEADER (
      EFI_ACPI_6_4_DEBUG_PORT_2_TABLE_SIGNATURE,
      HUMMER_DBG2, EFI_ACPI_DEBUG_PORT_2_TABLE_REVISION),
    .OffsetDbgDeviceInfo = OFFSET_OF (HUMMER_DBG2, Usb),
    .NumberDbgDeviceInfo = 1,
  },
  .Usb = {
    .Info = {
      .Length = sizeof (HUMMER_USB_DEBUG),
      .NumberofGenericAddressRegisters = 2,
      .NameSpaceStringLength = 2,
      .NameSpaceStringOffset = OFFSET_OF (HUMMER_USB_DEBUG, Name),
      .OemDataLength = sizeof (HUMMER_USB_DEBUG) - OFFSET_OF (HUMMER_USB_DEBUG, OemVersion),
      .OemDataOffset = OFFSET_OF (HUMMER_USB_DEBUG, OemVersion),
      .PortType = EFI_ACPI_DBG2_PORT_TYPE_NET,
      .PortSubtype = 0x5143,
      .BaseAddressRegisterOffset = OFFSET_OF (HUMMER_USB_DEBUG, Registers),
      .AddressSizeOffset = OFFSET_OF (HUMMER_USB_DEBUG, RegisterSizes),
    },
    .Registers = {
      { EFI_ACPI_6_4_SYSTEM_MEMORY, 32, 0, EFI_ACPI_6_4_DWORD, 0x0A600000 },
      { EFI_ACPI_6_4_SYSTEM_MEMORY, 32, 0, EFI_ACPI_6_4_DWORD, 0x0A600000 },
    },
    .RegisterSizes = { 0x100000, 0x1000 },
    .Name = ".",
    .OemVersion = 5,
    .OemSignature = SIGNATURE_32 ('2', 'X', 'I', 'F'),
    .FixCount = 2,
    .Fixes = {
      { 0, 2, 0, 0xF8810, MAX_UINT32, BIT20 | BIT28 },
      { 0, 2, 0, 0xF8830, MAX_UINT32, BIT24 },
    },
  },
};

VOID *CONST ReferenceAcpiTable = &Dbg2;
