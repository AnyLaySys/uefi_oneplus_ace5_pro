#include "AcpiTables.h"

#pragma pack (1)
typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR Header;
  UINT32 Cache;
} HUMMER_CLUSTER;

typedef struct {
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR Header;
  UINT32 Caches[2];
} HUMMER_CORE;

typedef struct {
  EFI_ACPI_DESCRIPTION_HEADER Header;
  EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR Package;
  HUMMER_CLUSTER Clusters[2];
  HUMMER_CORE Cpus[8];
  EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE Caches[18];
} HUMMER_PPTT;
#pragma pack ()

#define CACHE_OFFSET(Index) OFFSET_OF (HUMMER_PPTT, Caches[Index])
#define CLUSTER(Index) { \
  .Header = { .Type = EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR, .Length = sizeof (HUMMER_CLUSTER), \
    .Flags = { .IdenticalImplementation = 1 }, .Parent = OFFSET_OF (HUMMER_PPTT, Package), \
    .NumberOfPrivateResources = 1 }, .Cache = CACHE_OFFSET (16 + Index) }

#define CPU(Uid, Cluster) { \
  .Header = { .Type = EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR, .Length = sizeof (HUMMER_CORE), \
    .Flags = { .AcpiProcessorIdValid = 1, .NodeIsALeaf = 1 }, \
    .Parent = OFFSET_OF (HUMMER_PPTT, Clusters[Cluster]), .AcpiProcessorId = Uid, \
    .NumberOfPrivateResources = 2 }, .Caches = { CACHE_OFFSET (2 * Uid), CACHE_OFFSET (2 * Uid + 1) } }

#define CACHE(Id, KiB, Ways, Kind) { \
  .Type = EFI_ACPI_6_4_PPTT_TYPE_CACHE, .Length = sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_CACHE), \
  .Flags = { .SizePropertyValid = 1, .NumberOfSetsValid = 1, .AssociativityValid = 1, \
    .CacheTypeValid = 1, .LineSizeValid = 1, .CacheIdValid = 1 }, \
  .Size = KiB * 1024, .NumberOfSets = KiB * 1024 / (64 * Ways), \
  .Associativity = Ways, .Attributes = { .CacheType = Kind }, .LineSize = 64, .CacheId = Id }

#define L1(Uid, KiB, Ways) \
  CACHE (2 * Uid, 2 * KiB, Ways, EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_INSTRUCTION), \
  CACHE (2 * Uid + 1, KiB, Ways, EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_DATA)

HUMMER_PPTT Pptt = {
  .Header = HUMMER_ACPI_HEADER (
    EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_STRUCTURE_SIGNATURE,
    HUMMER_PPTT, EFI_ACPI_6_4_PROCESSOR_PROPERTIES_TOPOLOGY_TABLE_REVISION),
  .Package = {
    .Type = EFI_ACPI_6_4_PPTT_TYPE_PROCESSOR,
    .Length = sizeof (EFI_ACPI_6_4_PPTT_STRUCTURE_PROCESSOR),
    .Flags = { .PhysicalPackage = 1 },
  },
  .Clusters = { CLUSTER (0), CLUSTER (1) },
  .Cpus = {
    CPU (0, 0), CPU (1, 0), CPU (2, 0), CPU (3, 0),
    CPU (4, 0), CPU (5, 0), CPU (6, 1), CPU (7, 1),
  },
  .Caches = {
    L1 (0, 64, 4), L1 (1, 64, 4), L1 (2, 64, 4),
    L1 (3, 64, 4), L1 (4, 64, 4), L1 (5, 64, 4),
    L1 (6, 96, 6), L1 (7, 96, 6),
    CACHE (16, 12288, 12, EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED),
    CACHE (17, 12288, 12, EFI_ACPI_6_4_CACHE_ATTRIBUTES_CACHE_TYPE_UNIFIED),
  },
};

VOID *CONST ReferenceAcpiTable = &Pptt;
